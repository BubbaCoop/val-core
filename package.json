{
  "name": "@valiify/val-core",
  "version": "0.3.0",
  "description": "Val — the shared agent pipeline for Valiify component libraries: Figma extraction, component mapping, build, QA and visual accuracy. Templates + tools + methodology; each library supplies a val/config.json.",
  "type": "module",
  "bin": {
    "val-init": "bin/val-init.mjs"
  },
  "scripts": {
    "test": "node --test tools/*.test.mjs tools/qa/*.test.mjs tools/design/*.test.mjs",
    "check": "node bin/val-init.mjs --config val.config.example.json --dry-run"
  },
  "files": [
    "bin/",
    "schema/",
    "skills/",
    "templates/",
    "tools/",
    "val.config.example.json"
  ],
  "keywords": [
    "valiify",
    "val",
    "claude-code",
    "agents",
    "figma",
    "design-system"
  ],
  "author": "Valiify",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BubbaCoop/val-core.git"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pixelmatch": "^6.0.0",
    "playwright": "^1.48.0",
    "pngjs": "^7.0.0",
    "svelte": "^5.57.0"
  }
}
